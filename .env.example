# Copy to .env.local and fill in. Never commit real values.
TURSO_DATABASE_URL=file:C:/path/to/local.db     # libsql://<db>.turso.io in production
TURSO_AUTH_TOKEN=                                # required for remote Turso only
AUTH_SECRET=generate-with-openssl-rand-base64-32
CRON_SECRET=any-long-random-string
# CBMS (IRD) — inert until Admin enables transmission with real credentials
CBMS_ENDPOINT=
CBMS_USERNAME=
CBMS_PASSWORD=
# Vercel Blob — patient files (Phase 2)
BLOB_READ_WRITE_TOKEN=
